# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# Load before running forge:  set -a && source .env && set +a

# --- Required for deploy + live broadcast on Arbitrum Sepolia (chainId 421614) ---
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Signer: set PRIVATE_KEY *or* MNEMONIC (PRIVATE_KEY wins if both are set).
PRIVATE_KEY=0x_your_funded_testnet_key
# MNEMONIC="test test test test test test test test test test test junk"
# MNEMONIC_INDEX=0   # account index for the mnemonic (default 0)

# --- Optional ---
# Block explorer verification (Arbiscan Sepolia). Leave empty to skip --verify.
ARBISCAN_API_KEY=
# DEFAULT_ADMIN_ROLE holder. Defaults to the broadcast sender if unset.
OWNER=
# Underlying ERC20. If unset, Deploy.s.sol deploys a mintable MockToken (mUSD, 6 decimals).
ASSET=
# CREATE2 salt for the Vault address. Defaults to 0.
SALT=

# --- Filled in AFTER deploy (from console output / broadcast run-latest.json) ---
# Consumed by script/IntegrationReport.s.sol.
VAULT=
STRATEGY_MANAGER=
ROLE_MANAGER=
TIMELOCK=
ASSET_ADDR=

# Amounts for the integration scenario (in asset's smallest unit). Defaults shown.
# mUSD has 6 decimals, so 1_000_000 = 1 mUSD.
DEPOSIT_ASSETS=1000000
MINT_SHARES=500000
ALLOCATE_ASSETS=400000
